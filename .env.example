# Copy to .env for local deployment, never put credentials here.
APP_HOST_PORT=8765
PROJECT_DATA_PATH=./Tailieuthamkhao/Giaodienfrontend/luoi
MAP_PREDICT_MAX_UPLOAD_BYTES=67108864
MAP_PREDICT_ASSISTANT_ENABLED=1
MAP_PREDICT_ASSISTANT_MODEL=gemini-3.5-flash-lite
# Qdrant belongs to this Compose project and uses a persistent Docker volume.
AI_QDRANT_URL=http://qdrant:6333
AI_QDRANT_COLLECTION=CSDL-Datdai
# Shared embedding model for RAGWire retrieval and authenticated admin tools.
AI_EMBEDDING_URL=http://ai-embedding:11434
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
