FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/var/lib/gemini-browser
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium socat ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home browser \
    && mkdir -p /var/lib/gemini-browser /etc/chromium/policies/managed \
    && chown 10001:10001 /var/lib/gemini-browser \
    && printf '%s\n' '{"PasswordManagerEnabled":false,"SyncDisabled":true}' \
       > /etc/chromium/policies/managed/gemini.json
WORKDIR /app
COPY integrations/start_gemini_browser.sh /app/start_gemini_browser.sh
USER 10001:10001
EXPOSE 9222
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:9222/json/version',timeout=3)); assert d.get('Browser') and d.get('webSocketDebuggerUrl')"
CMD ["sh", "/app/start_gemini_browser.sh"]
